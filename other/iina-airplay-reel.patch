+func TestStopSubcommandReturnsNonzeroWhenHelperReportsTeardownFailure(t *testing.T) {
+	bin := buildHelper(t)
+	out := t.TempDir()
+	mediaPath := filepath.Join(out, "index.m3u8")
+	if err := os.WriteFile(mediaPath, []byte("#EXTM3U\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command("/bin/sleep", "30")
+	if err := child.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = child.Process.Kill()
+		_ = child.Wait()
+	})
+	if err := os.WriteFile(filepath.Join(out, "helper.pid"), []byte(strconv.Itoa(child.Process.Pid)), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(out, instanceFailureName), []byte("simulated child shutdown failure\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	err := exec.Command(bin, "stop", "-out", out).Run()
+	var exitErr *exec.ExitError
+	if !errors.As(err, &exitErr) || exitErr.ExitCode() == 0 {
+		t.Fatalf("stop error=%v, want nonzero exit status", err)
+	}
+	if !systemProcesses.alive(child.Process.Pid) {
+		t.Fatal("stop should fail closed without signaling the numeric PID in helper.pid")
+	}
+	if _, err := os.Stat(mediaPath); err != nil {
+		t.Fatalf("unsafe shutdown deleted cast output: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(out, instanceFailureName)); err != nil {
+		t.Fatalf("unsafe shutdown result should remain for a retry: %v", err)
+	}
+}
