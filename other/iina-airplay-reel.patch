+func TestDiskWatcherCoalescesWriteStormToBoundedScanRate(t *testing.T) {
+	out := t.TempDir()
+	path := filepath.Join(out, "seg_0000.m4s")
+	if err := os.WriteFile(path, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	initialCheck := make(chan struct{}, 1)
+	var checks atomic.Int32
+	stop, errors := watchCastDiskUsage(out, 1<<30, 50, 100*time.Millisecond,
+		func(string) (uint64, error) {
+			if checks.Add(1) == 1 {
+				initialCheck <- struct{}{}
+			}
+			return 1 << 30, nil
+		})
+	defer stop()
+	select {
+	case <-initialCheck:
+	case <-time.After(time.Second):
+		t.Fatal("disk watcher did not start")
+	}
+	f, err := os.OpenFile(path, os.O_APPEND|os.O_WRONLY, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(300 * time.Millisecond)
+	for time.Now().Before(deadline) {
+		if _, err := f.Write([]byte("x")); err != nil {
+			_ = f.Close()
+			t.Fatal(err)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-errors:
+		t.Fatalf("disk watcher failed during write storm: %v", err)
+	default:
+	}
+	stop()
+	count := checks.Load()
+	if count < 2 || count > 6 {
+		t.Fatalf("disk scans during 300ms write storm=%d; want event-driven checks bounded near 10/s", count)
+	}
+}
