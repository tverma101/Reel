+const ffmpegStderrTailBytes = 64 * 1024
+
+// boundedTailWriter keeps only the most recent FFmpeg diagnostics.
+// FFmpeg can emit warnings for the lifetime of a real-time cast, so retaining
+// all stderr would make helper memory grow with playback time.
+type boundedTailWriter struct {
+	mu    sync.Mutex
+	limit int
+	tail  []byte
+}
+
+func newBoundedTailWriter(limit int) *boundedTailWriter {
+	if limit < 0 {
+		limit = 0
+	}
+	return &boundedTailWriter{limit: limit, tail: make([]byte, 0, limit)}
+}
+
+func (w *boundedTailWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	n := len(p)
+	if w.limit == 0 {
+		return n, nil
+	}
+	if n >= w.limit {
+		w.tail = append(w.tail[:0], p[n-w.limit:]...)
+		return n, nil
+	}
+	overflow := len(w.tail) + n - w.limit
+	if overflow > 0 {
+		copy(w.tail, w.tail[overflow:])
+		w.tail = w.tail[:len(w.tail)-overflow]
+	}
+	w.tail = append(w.tail, p...)
+	return n, nil
+}
+
+func (w *boundedTailWriter) String() string {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return string(w.tail)
+}
