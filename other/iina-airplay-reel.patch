+func TestWaitForOwnedHelperStopAcceptsRemovedPIDAfterTeardown(t *testing.T) {
+	out := t.TempDir()
+	if err := os.WriteFile(filepath.Join(out, "index.m3u8"), []byte("#EXTM3U\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	ops := processController{
+		// The parent has not reaped the clean helper yet, so kill(pid, 0) may
+		// still report its zombie process. PID-file removal is after teardown.
+		alive: func(int) bool { return true },
+		now:   time.Now,
+		sleep: time.Sleep,
+	}
+	if err := waitForOwnedHelperStop(out, 4242, time.Now().Add(time.Second), ops, systemProcessGroups); err != nil {
+		t.Fatalf("clean helper teardown was not accepted after PID-file removal: %v", err)
+	}
+	if _, err := os.Stat(out); !os.IsNotExist(err) {
+		t.Fatalf("stopped cast output directory remains: %v", err)
+	}
+}
