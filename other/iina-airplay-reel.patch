+func TestDiskWatcherStopsAfterBoundedWriteBurst(t *testing.T) {
+	out := t.TempDir()
+	const budget = uint64(1 << 20)
+	const baseline = 512 << 10
+	const burst = 4 << 20
+	if err := os.WriteFile(filepath.Join(out, "seg_0000.m4s"), make([]byte, baseline), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	initialCheck := make(chan struct{}, 1)
+	var checks atomic.Int32
+	stop, errors := watchCastDiskUsage(out, budget, 50, 100*time.Millisecond,
+		func(string) (uint64, error) {
+			if checks.Add(1) == 1 {
+				initialCheck <- struct{}{}
+			}
+			return 1000, nil
+		})
+	defer stop()
+	select {
+	case <-initialCheck:
+	case <-time.After(time.Second):
+		t.Fatal("disk watcher did not perform its initial high-water check")
+	}
+	f, err := os.OpenFile(filepath.Join(out, "seg_0000.m4s"), os.O_APPEND|os.O_WRONLY, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := f.Write(make([]byte, burst)); err != nil {
+		_ = f.Close()
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-errors:
+		if err == nil || !strings.Contains(err.Error(), "output exceeded") {
+			t.Fatalf("disk watcher error=%v, want high-water failure", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("disk watcher did not detect a burst that crossed the output budget")
+	}
+	used, err := castOutputBytes(out)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if used <= budget || used-budget > burst {
+		t.Fatalf("output after one write burst=%d; want threshold crossing with overshoot <= %d", used, burst)
+	}
+}
