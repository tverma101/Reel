@@ -0,0 +1,23 @@
+package main
+
+import (
+	"regexp"
+	"testing"
+)
+
+func TestNewCastTokenIsUnpredictableAndURLSafe(t *testing.T) {
+	first, err := NewCastToken()
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := NewCastToken()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !regexp.MustCompile(`^[0-9a-f]{32}$`).MatchString(first) {
+		t.Fatalf("token is not a 128-bit lowercase hex path segment: %q", first)
+	}
+	if first == second {
+		t.Fatal("two independently generated cast tokens were identical")
+	}
+}
