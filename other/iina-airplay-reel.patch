+	recordHelperFailure(out, "follow-up teardown failure")
+	record, present, err := readHelperFailure(filepath.Join(out, instanceFailureName))
+	if err != nil || !present {
+		t.Fatalf("read failure marker: present=%v err=%v", present, err)
+	}
