+func TestProcessGroupProbeRateIsBounded(t *testing.T) {
+	now := time.Unix(100, 0)
+	probes, sleeps := 0, 0
+	ops := processController{
+		alive: func(int) bool { probes++; return true },
+		now:   func() time.Time { return now },
+		sleep: func(d time.Duration) { sleeps++; now = now.Add(d) },
+	}
+	const timeout = 250 * time.Millisecond
+	if waitForProcessGroupExitWithOps(42, timeout, ops) {
+		t.Fatal("live process group unexpectedly exited")
+	}
+	if probes != 4 || sleeps != 3 {
+		t.Fatalf("probes=%d sleeps=%d, want 4 bounded probes and 3 waits", probes, sleeps)
+	}
+	if elapsed := now.Sub(time.Unix(100, 0)); elapsed != timeout {
+		t.Fatalf("waited %s, want exactly %s", elapsed, timeout)
+	}
+}
