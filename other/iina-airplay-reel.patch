+func TestLifecycleLockHasNoOwnerPublicationWindow(t *testing.T) {
+	root := t.TempDir()
+	outA := filepath.Join(root, "cast-a")
+	outB := filepath.Join(root, "cast-b")
+	for _, out := range []string{outA, outB} {
+		if err := os.Mkdir(out, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	first, err := lockInstance(outA, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lockInfo, err := os.Lstat(filepath.Join(root, instanceLockFileName))
+	if err != nil {
+		t.Fatalf("atomic lifecycle lock file was not published: %v", err)
+	}
+	if !lockInfo.Mode().IsRegular() {
+		t.Fatalf("lifecycle lock path has mode %v, want a regular lock file", lockInfo.Mode())
+	}
+	secondResult := make(chan error, 1)
+	go func() {
+		second, err := lockInstance(outB, time.Second)
+		if err == nil {
+			err = second.release()
+		}
+		secondResult <- err
+	}()
+	time.Sleep(50 * time.Millisecond)
+	select {
+	case err := <-secondResult:
+		t.Fatalf("second cast acquired the root lifecycle lock while held: %v", err)
+	default:
+	}
+	if err := first.release(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-secondResult:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("second cast did not acquire the lifecycle lock after release")
+	}
+}
