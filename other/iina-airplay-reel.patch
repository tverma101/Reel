new file mode 100644
index 0000000..cc41b10aa5f738377a6a05803e484a6056629f04
--- /dev/null
+++ b/helper/lifecycle.go
@@ -0,0 +1,990 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+const (
+	instanceLockFileName = ".helper.lifecycle.lock"
+	instanceStopName     = "helper.stop"
+	instanceFailureName  = "helper.failure"
+
+	// The stop command waits for marker-driven helper teardown without signaling
+	// a PID. Keep its helper wait bounded above FFmpeg/server shutdown deadlines.
+	helperShutdownGrace    = 40 * time.Second
+	helperKillWait         = 1 * time.Second
+	instanceLockWait       = 8 * time.Second
+	castStartWindow        = 20 * time.Second
+	castStartPoll          = 100 * time.Millisecond
+	processProbeInterval   = 100 * time.Millisecond
+	failureMarkerMaxBytes  = 4096
+	processFileMaxBytes    = 128
+	castOrphanDirectoryAge = 24 * time.Hour
+	castOutputEntryLimit   = 512
+	castRootEntryLimit     = 4096
+	castDirectorySyncLimit = time.Second
+)
+
+func verifyNoSymlinkDirectoryPath(path string, allowMissing bool) error {
+	info, err := os.Lstat(path)
+	if os.IsNotExist(err) && allowMissing {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if info.Mode()&os.ModeSymlink != 0 || !info.IsDir() {
+		return fmt.Errorf("cast directory %q is not a real directory", path)
+	}
+	return nil
+}
+
+// System paths such as /var may be symlink aliases on macOS. Create parents
+// normally, then reject a symlink at the actual cast directory and open that
+// final component with O_NOFOLLOW before changing its mode.
+func createPrivateDirectoryPath(path string) error {
+	if err := os.MkdirAll(path, 0o700); err != nil {
+		return err
+	}
+	if err := verifyNoSymlinkDirectoryPath(filepath.Dir(path), false); err != nil {
+		return fmt.Errorf("cast root is unsafe: %w", err)
+	}
+	if err := verifyNoSymlinkDirectoryPath(path, false); err != nil {
+		return err
+	}
+	fd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_DIRECTORY|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return err
+	}
+	dir := os.NewFile(uintptr(fd), path)
+	defer dir.Close()
+	return dir.Chmod(0o700)
+}
+
+type processController struct {
+	alive func(int) bool
+	now   func() time.Time
+	sleep func(time.Duration)
+}
+
+var systemProcesses = processController{
+	alive: processAlive,
+	now:   time.Now,
+	sleep: time.Sleep,
+}
+
+var systemProcessGroups = processController{
+	alive: processGroupActive,
+	now:   time.Now,
+	sleep: time.Sleep,
+}
+
+// retryBounded retries a failed teardown until it succeeds or the deadline
+// expires. The attempt must itself avoid unsafe numeric-ID signaling.
+func retryBounded(timeout, interval time.Duration, now func() time.Time, sleep func(time.Duration), attempt func() error) error {
+	deadline := now().Add(timeout)
+	var lastErr error
+	for {
+		if err := attempt(); err == nil {
+			return nil
+		} else {
+			lastErr = err
+		}
+		remaining := deadline.Sub(now())
+		if remaining <= 0 {
+			return lastErr
+		}
+		pause := interval
+		if remaining < pause {
+			pause = remaining
+		}
+		sleep(pause)
+	}
+}
+
+// kill(pid, 0) is a conservative liveness probe. Zombies count as present;
+// this can retain output longer, but avoids spawning ps on each wait poll and
+// never authorizes a signal based on a reused numeric PID.
+func processActive(pid int) bool { return processAlive(pid) }
+
+type instanceLock struct {
+	file *os.File
+}
+
+// lockInstance uses a kernel advisory lock on one persistent file per cast
+// root. The lock inode is never unlinked while waiters may hold descriptors,
+// and flock serializes acquisition before any owner metadata is published.
+// This avoids the empty-directory window that let waiters misclassify a live
+// creator as stale between Mkdir and writing owner.pid.
+func lockInstance(outDir string, timeout time.Duration) (*instanceLock, error) {
+	root := filepath.Dir(outDir)
+	if err := verifyNoSymlinkDirectoryPath(root, false); err != nil {
+		return nil, fmt.Errorf("inspect cast root for lifecycle lock: %w", err)
+	}
+	lockPath := filepath.Join(root, instanceLockFileName)
+	file, err := openRegularFileNoFollow(lockPath, syscall.O_RDWR|syscall.O_CREAT, 0o600)
+	if err != nil {
+		return nil, fmt.Errorf("open helper lifecycle lock: %w", err)
+	}
+	if err := file.Chmod(0o600); err != nil {
+		_ = file.Close()
+		return nil, fmt.Errorf("secure helper lifecycle lock: %w", err)
+	}
+	deadline := time.Now().Add(timeout)
+	for {
+		err := syscall.Flock(int(file.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+		if err == nil {
+			return &instanceLock{file: file}, nil
+		}
+		if !errors.Is(err, syscall.EWOULDBLOCK) && !errors.Is(err, syscall.EAGAIN) {
+			_ = file.Close()
+			return nil, fmt.Errorf("acquire helper lifecycle lock: %w", err)
+		}
+		remaining := time.Until(deadline)
+		if remaining <= 0 {
+			_ = file.Close()
+			return nil, fmt.Errorf("timed out waiting for helper lifecycle lock")
+		}
+		pause := processProbeInterval
+		if remaining < pause {
+			pause = remaining
+		}
+		time.Sleep(pause)
+	}
+}
+
+func (l *instanceLock) release() error {
+	if l == nil || l.file == nil {
+		return nil
+	}
+	err := syscall.Flock(int(l.file.Fd()), syscall.LOCK_UN)
+	closeErr := l.file.Close()
+	if err != nil {
+		return err
+	}
+	return closeErr
+}
+
+func recordHelperFailure(outDir, message string) {
+	recordHelperFailureWithPGID(outDir, message, 0)
+}
+
+func recordHelperFailureWithPGID(outDir, message string, knownPGID int) {
+	if outDir == "" {
+		return
+	}
+	ffmpegPGID := knownPGID
+	if ffmpegPGID == 0 {
+		pid, present, err := readProcessPID(filepath.Join(outDir, ffmpegPIDName))
+		if err != nil {
+			ffmpegPGID = -1 // malformed or unreadable evidence fails closed
+		} else if present {
+			ffmpegPGID = pid
+		} else if prior, present, err := readHelperFailure(filepath.Join(outDir, instanceFailureName)); err != nil {
+			ffmpegPGID = -1 // malformed prior evidence fails closed
+		} else if present && prior.ffmpegPGID > 0 {
+			ffmpegPGID = prior.ffmpegPGID
+		}
+	}
+	message = strings.ReplaceAll(message, "\n", " ")
+	if len(message) > failureMarkerMaxBytes/2 {
+		message = message[:failureMarkerMaxBytes/2]
+	}
+	data := fmt.Sprintf("version=1\nhelper_pid=%d\nffmpeg_pgid=%d\nmessage=%s\n", os.Getpid(), ffmpegPGID, message)
+	file, err := openRegularFileNoFollow(filepath.Join(outDir, instanceFailureName), syscall.O_WRONLY|syscall.O_CREAT|syscall.O_TRUNC, 0o600)
+	if err != nil {
+		return
+	}
+	defer file.Close()
+	if _, err := io.WriteString(file, data); err != nil {
+		return
+	}
+	_ = file.Sync()
+}
+
+type helperFailureRecord struct {
+	helperPID  int
+	ffmpegPGID int
+	message    string
+}
+
+func readHelperFailure(path string) (helperFailureRecord, bool, error) {
+	data, err := readRegularFileNoFollow(path, failureMarkerMaxBytes)
+	if os.IsNotExist(err) {
+		return helperFailureRecord{}, false, nil
+	}
+	if err != nil {
+		return helperFailureRecord{}, false, err
+	}
+	values := make(map[string]string, 4)
+	for _, line := range strings.Split(string(data), "\n") {
+		key, value, ok := strings.Cut(line, "=")
+		if !ok || key == "" {
+			continue
+		}
+		if _, exists := values[key]; exists {
+			return helperFailureRecord{}, true, fmt.Errorf("duplicate %s field", key)
+		}
+		values[key] = value
+	}
+	if values["version"] != "1" {
+		return helperFailureRecord{}, true, fmt.Errorf("unrecognized or legacy failure marker")
+	}
+	helperPID, helperErr := strconv.Atoi(values["helper_pid"])
+	ffmpegPGID, ffmpegErr := strconv.Atoi(values["ffmpeg_pgid"])
+	if helperErr != nil || helperPID <= 0 || ffmpegErr != nil || ffmpegPGID < 0 {
+		return helperFailureRecord{}, true, fmt.Errorf("invalid process identity in failure marker")
+	}
+	return helperFailureRecord{helperPID: helperPID, ffmpegPGID: ffmpegPGID, message: values["message"]}, true, nil
+}
+
+func readRegularFileNoFollow(path string, limit int) ([]byte, error) {
+	file, err := openRegularFileNoFollow(path, syscall.O_RDONLY, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	if limit <= 0 {
+		return nil, fmt.Errorf("invalid file size limit %d", limit)
+	}
+	data, err := io.ReadAll(io.LimitReader(file, int64(limit)+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > limit {
+		return nil, fmt.Errorf("file %q exceeds %d byte limit", path, limit)
+	}
+	return data, nil
+}
+
+func openRegularFileNoFollow(path string, flags int, mode uint32) (*os.File, error) {
+	fd, err := syscall.Open(path, flags|syscall.O_NOFOLLOW, mode)
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	info, err := file.Stat()
+	if err != nil {
+		_ = file.Close()
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		_ = file.Close()
+		return nil, fmt.Errorf("file %q is not a regular file", path)
+	}
+	return file, nil
+}
+
+func writeRegularFileNoFollow(path string, data []byte, mode uint32) error {
+	file, err := openRegularFileNoFollow(path, syscall.O_WRONLY|syscall.O_CREAT|syscall.O_TRUNC, mode)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	if _, err := file.Write(data); err != nil {
+		return err
+	}
+	return file.Sync()
+}
+
+func stopRequested(outDir string) bool {
+	_, err := os.Lstat(filepath.Join(outDir, instanceStopName))
+	return err == nil
+}
+
+func helperFailurePresent(outDir string) bool {
+	_, err := os.Lstat(filepath.Join(outDir, instanceFailureName))
+	return err == nil
+}
+
+func readProcessPID(path string) (int, bool, error) {
+	data, err := readRegularFileNoFollow(path, processFileMaxBytes)
+	if os.IsNotExist(err) {
+		return 0, false, nil
+	}
+	if err != nil {
+		return 0, false, err
+	}
+	pid, err := strconv.Atoi(strings.TrimSpace(string(data)))
+	if err != nil || pid <= 0 {
+		return 0, true, fmt.Errorf("invalid process ID file %q", path)
+	}
+	return pid, true, nil
+}
+
+// TakeOver deliberately refuses to signal an existing PID file. Callers that
+// own a live helper must request teardown through helper.stop and await the
+// helper's own child handles; stale numeric IDs are never signal authority.
+func TakeOver(path string) error {
+	_, exists, err := readProcessPID(path)
+	if err != nil {
+		return fmt.Errorf("inspect helper pidfile: %w", err)
+	}
+	if exists {
+		return fmt.Errorf("existing helper pidfile; refusing PID-based takeover")
+	}
+	return nil
+}
+
+// StopInstance records cancellation before consulting helper.pid. If serve
+// has not published its PID yet, its startup lock observes the marker and
+// exits before starting FFmpeg or the HTTP server.
+func StopInstance(outDir string) error {
+	return StopInstanceAt(outDir, time.Time{})
+}
+
+// StopInstanceAt uses the same finite startup deadline attached to a queued
+// serve command. Once that deadline passes, a delayed serve is required to
+// refuse startup, so the stop path can safely remove its cancellation marker.
+func StopInstanceAt(outDir string, startDeadline time.Time) error {
+	return stopInstanceWithProcesses(outDir, startDeadline, systemProcesses, systemProcessGroups)
+}
+
+func stopInstanceWithProcesses(outDir string, startDeadline time.Time, helperOps, groupOps processController) error {
+	if err := createPrivateDirectoryPath(outDir); err != nil {
+		return fmt.Errorf("prepare cast output directory: %w", err)
+	}
+	lock, err := lockInstance(outDir, instanceLockWait)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return err
+	}
+	marker := filepath.Join(outDir, instanceStopName)
+	deadlineSeconds := int64(0)
+	if !startDeadline.IsZero() {
+		deadlineSeconds = startDeadline.Unix()
+	}
+	if err := writeRegularFileNoFollow(marker, []byte(strconv.FormatInt(deadlineSeconds, 10)+"\n"), 0o600); err != nil {
+		_ = lock.release()
+		return fmt.Errorf("record cast stop request: %w", err)
+	}
+	if err := lock.release(); err != nil {
+		return fmt.Errorf("release cast lifecycle lock: %w", err)
+	}
+
+	helperPID, helperPresent, err := readProcessPID(filepath.Join(outDir, "helper.pid"))
+	if err != nil {
+		return fmt.Errorf("inspect helper pidfile: %w", err)
+	}
+	if helperPresent {
+		deadline := time.Now().Add(helperShutdownGrace)
+		if !startDeadline.IsZero() && startDeadline.After(time.Now()) && startDeadline.After(deadline) {
+			deadline = startDeadline.Add(helperShutdownGrace)
+		}
+		return waitForOwnedHelperStop(outDir, helperPID, deadline, helperOps, groupOps)
+	}
+	if !startDeadline.IsZero() && startDeadline.After(time.Now()) {
+		return waitForQueuedServe(outDir, startDeadline, helperOps, groupOps)
+	}
+	// Read and validate failure state before any zero-deadline/legacy return.
+	return finishStoppedCast(outDir, helperOps, groupOps)
+}
+
+func waitForOwnedHelperStop(outDir string, expectedPID int, deadline time.Time, helperOps, groupOps processController) error {
+	for time.Now().Before(deadline) {
+		failure, present, err := readHelperFailure(filepath.Join(outDir, instanceFailureName))
+		if err != nil {
+			return fmt.Errorf("cannot verify helper shutdown result: %w; preserving cast output", err)
+		}
+		if present {
+			return fmt.Errorf("helper teardown failed (%s); preserving cast output", failure.message)
+		}
+		pid, hasPID, err := readProcessPID(filepath.Join(outDir, "helper.pid"))
+		if err != nil {
+			return fmt.Errorf("inspect helper pidfile: %w", err)
+		}
+		if hasPID && pid != expectedPID {
+			return fmt.Errorf("helper identity changed while stopping; preserving cast output")
+		}
+		if !hasPID || !helperOps.alive(expectedPID) {
+			// A clean helper removes helper.pid only after teardown has stopped
+			// writers and swept output. Do not wait for kill(pid, 0) to clear
+			// after that boundary: a parent may not have reaped the helper yet.
+			return finishStoppedCast(outDir, helperOps, groupOps)
+		}
+		time.Sleep(processProbeInterval)
+	}
+	return fmt.Errorf("timed out waiting for the owning helper to stop; preserving cast output")
+}
+
+func finishStoppedCast(outDir string, helperOps, groupOps processController) error {
+	if failure, present, err := readHelperFailure(filepath.Join(outDir, instanceFailureName)); err != nil {
+		return fmt.Errorf("cannot verify helper shutdown result: %w; preserving cast output", err)
+	} else if present {
+		if helperOps.alive(failure.helperPID) {
+			return fmt.Errorf("helper %d from failure record may still be active; preserving output", failure.helperPID)
+		}
+		if failure.ffmpegPGID > 0 && groupOps.alive(failure.ffmpegPGID) {
+			return fmt.Errorf("FFmpeg process group %d from failure record may still be active; preserving output", failure.ffmpegPGID)
+		}
+	}
+	if pid, present, err := readProcessPID(filepath.Join(outDir, ffmpegPIDName)); err != nil {
+		return fmt.Errorf("inspect FFmpeg PID file: %w; preserving output", err)
+	} else if present && groupOps.alive(pid) {
+		return fmt.Errorf("FFmpeg process group %d may still be writing; preserving output", pid)
+	}
+	if err := cleanOutDir(outDir); err != nil {
+		return fmt.Errorf("clean stopped cast output: %w", err)
+	}
+	for _, name := range []string{instanceStopName, instanceFailureName, "helper.pid", ffmpegPIDName} {
+		if err := os.Remove(filepath.Join(outDir, name)); err != nil && !os.IsNotExist(err) {
+			return fmt.Errorf("remove helper lifecycle file: %w", err)
+		}
+	}
+	if err := removeEmptyCastDir(outDir); err != nil {
+		return fmt.Errorf("remove empty cast output directory: %w", err)
+	}
+	return nil
+}
+
+func waitForQueuedServe(outDir string, deadline time.Time, helperOps, groupOps processController) error {
+	for time.Now().Before(deadline) {
+		if _, err := os.Stat(outDir); os.IsNotExist(err) {
+			return nil // the matching serve consumed the marker and removed its dir
+		} else if err != nil {
+			return fmt.Errorf("inspect queued cast directory: %w", err)
+		}
+		lock, err := lockInstance(outDir, instanceLockWait)
+		if err != nil {
+			if os.IsNotExist(err) {
+				return nil
+			}
+			return err
+		}
+		pidfile := filepath.Join(outDir, "helper.pid")
+		if _, err := os.Stat(pidfile); err == nil {
+			if err := lock.release(); err != nil {
+				return err
+			}
+			return stopInstanceWithProcesses(outDir, deadline, helperOps, groupOps)
+		} else if !os.IsNotExist(err) {
+			_ = lock.release()
+			return fmt.Errorf("inspect helper pidfile: %w", err)
+		}
+		if _, err := os.Stat(filepath.Join(outDir, instanceStopName)); os.IsNotExist(err) {
+			_ = lock.release()
+			return nil // the serve command consumed the cancellation marker
+		}
+		if err := lock.release(); err != nil {
+			return err
+		}
+		time.Sleep(castStartPoll)
+	}
+	// The deadline is now expired. A late serve is rejected by runServe before
+	// it can launch FFmpeg; remove only this cast's stale marker and artifacts.
+	return stopInstanceWithProcesses(outDir, deadline, helperOps, groupOps)
+}
+
+func removeEmptyCastDir(outDir string) error {
+	err := os.Remove(outDir) // only succeeds when no unknown files remain
+	if err == nil || os.IsNotExist(err) || errors.Is(err, syscall.ENOTEMPTY) || errors.Is(err, syscall.EEXIST) {
+		return nil
+	}
+	return err
+}
+
+func expiredStopMarker(outDir string, now time.Time) bool {
+	data, err := readRegularFileNoFollow(filepath.Join(outDir, instanceStopName), processFileMaxBytes)
+	if err != nil {
+		return false
+	}
+	deadline, err := strconv.ParseInt(strings.TrimSpace(string(data)), 10, 64)
+	return err == nil && deadline > 0 && now.Unix() > deadline
+}
+
+func oldMarkerlessCastDir(outDir string, now time.Time) (bool, error) {
+	marker := filepath.Join(outDir, instanceStopName)
+	if _, err := os.Lstat(marker); err == nil {
+		return false, nil // unknown, malformed, or future markers are protected
+	} else if !os.IsNotExist(err) {
+		return false, fmt.Errorf("inspect cast stop marker: %w", err)
+	}
+	info, err := os.Stat(outDir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return false, nil // another cast cleanup removed the directory
+		}
+		return false, err
+	}
+	return !now.Before(info.ModTime().Add(castOrphanDirectoryAge)), nil
+}
+
+// pruneExpiredCastDirs removes only unique cast directories whose stop token
+// expired or whose markerless directory has been untouched for a day. A
+// queued serve carries a finite start deadline; PID and lifecycle-lock checks
+// below protect any helper that could still own output before files are swept.
+func pruneExpiredCastDirs(root, currentOutDir string, now time.Time) error {
+	return pruneExpiredCastDirsBefore(root, currentOutDir, now, time.Time{})
+}
+
+func pruneExpiredCastDirsBefore(root, currentOutDir string, now, deadline time.Time) error {
+	checkDeadline := func() error {
+		if !deadline.IsZero() && !time.Now().Before(deadline) {
+			return fmt.Errorf("cast startup deadline expired during cache pruning")
+		}
+		return nil
+	}
+	if err := checkDeadline(); err != nil {
+		return err
+	}
+	if err := verifyNoSymlinkDirectoryPath(root, true); err != nil {
+		return err
+	}
+	entries, err := readCastDir(root, castRootEntryLimit)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		if err := checkDeadline(); err != nil {
+			return err
+		}
+		if !entry.IsDir() || !strings.HasPrefix(entry.Name(), "cast-") {
+			continue
+		}
+		outDir := filepath.Join(root, entry.Name())
+		if outDir == currentOutDir {
+			continue
+		}
+		expiredMarker := expiredStopMarker(outDir, now)
+		if !expiredMarker {
+			oldOrphan, err := oldMarkerlessCastDir(outDir, now)
+			if err != nil {
+				return err
+			}
+			if !oldOrphan {
+				continue
+			}
+		}
+		lockWait := 100 * time.Millisecond
+		if !deadline.IsZero() {
+			remaining := time.Until(deadline)
+			if remaining <= 0 {
+				return checkDeadline()
+			}
+			if remaining < lockWait {
+				lockWait = remaining
+			}
+		}
+		lock, err := lockInstance(outDir, lockWait)
+		if err != nil {
+			if errors.Is(err, os.ErrNotExist) {
+				continue
+			}
+			if strings.Contains(err.Error(), "timed out") {
+				continue // an active lifecycle owner retains the directory
+			}
+			return err
+		}
+		if err := checkDeadline(); err != nil {
+			_ = lock.release()
+			return err
+		}
+		if expiredMarker {
+			if !expiredStopMarker(outDir, now) {
+				_ = lock.release()
+				continue
+			}
+		} else {
+			if _, err := os.Lstat(filepath.Join(outDir, instanceStopName)); err == nil {
+				_ = lock.release()
+				continue
+			} else if !os.IsNotExist(err) {
+				_ = lock.release()
+				return err
+			}
+		}
+		if pid, present, err := readProcessPID(filepath.Join(outDir, "helper.pid")); err == nil {
+			if present && systemProcesses.alive(pid) {
+				_ = lock.release()
+				continue
+			}
+		} else {
+			_ = lock.release()
+			return fmt.Errorf("inspect cast helper PID: %w", err)
+		}
+		if pid, present, err := readProcessPID(filepath.Join(outDir, ffmpegPIDName)); err == nil {
+			if present && systemProcessGroups.alive(pid) {
+				_ = lock.release()
+				continue
+			}
+		} else {
+			_ = lock.release()
+			return fmt.Errorf("inspect cast FFmpeg process group: %w", err)
+		}
+		if helperFailurePresent(outDir) {
+			_ = lock.release()
+			continue // a helper explicitly declared cleanup unsafe
+		}
+		if err := cleanOutDir(outDir); err != nil {
+			_ = lock.release()
+			return fmt.Errorf("clean expired cast output: %w", err)
+		}
+		for _, name := range []string{instanceStopName, "helper.pid", ffmpegPIDName} {
+			if err := os.Remove(filepath.Join(outDir, name)); err != nil && !os.IsNotExist(err) {
+				_ = lock.release()
+				return err
+			}
+		}
+		if err := lock.release(); err != nil {
+			return err
+		}
+		if err := removeEmptyCastDir(outDir); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func discardExpiredUnstartedCast(outDir string) error {
+	if _, err := os.Stat(outDir); os.IsNotExist(err) {
+		return nil
+	} else if err != nil {
+		return err
+	}
+	lock, err := lockInstance(outDir, instanceLockWait)
+	if err != nil {
+		return err
+	}
+	if _, present, err := readProcessPID(filepath.Join(outDir, "helper.pid")); err == nil {
+		if present {
+			_ = lock.release()
+			return fmt.Errorf("expired cast unexpectedly has a helper pid")
+		}
+	} else {
+		_ = lock.release()
+		return fmt.Errorf("inspect expired cast helper PID: %w", err)
+	}
+	if pid, present, err := readProcessPID(filepath.Join(outDir, ffmpegPIDName)); err == nil {
+		if present && systemProcessGroups.alive(pid) {
+			_ = lock.release()
+			return fmt.Errorf("expired cast still has a live ffmpeg process; preserving output")
+		}
+	} else {
+		_ = lock.release()
+		return fmt.Errorf("inspect expired cast FFmpeg process group: %w", err)
+	}
+	if helperFailurePresent(outDir) {
+		_ = lock.release()
+		return fmt.Errorf("expired cast reported unsafe cleanup; preserving output")
+	}
+	if err := cleanOutDir(outDir); err != nil {
+		_ = lock.release()
+		return fmt.Errorf("clean expired cast output: %w", err)
+	}
+	for _, name := range []string{instanceStopName, "helper.pid", ffmpegPIDName} {
+		if err := os.Remove(filepath.Join(outDir, name)); err != nil && !os.IsNotExist(err) {
+			_ = lock.release()
+			return err
+		}
+	}
+	if err := lock.release(); err != nil {
+		return err
+	}
+	return removeEmptyCastDir(outDir)
+}
+
+type castDiskLimits struct {
+	maxOutputBytes   uint64
+	minimumFreeBytes uint64
+	pollInterval     time.Duration
+}
+
+var productionCastDiskLimits = castDiskLimits{
+	maxOutputBytes:   castMaxOutputBytes,
+	minimumFreeBytes: castMinimumFreeBytes,
+	pollInterval:     castDiskPollInterval,
+}
+
+func availableBytes(path string) (uint64, error) {
+	var stat syscall.Statfs_t
+	if err := syscall.Statfs(path, &stat); err != nil {
+		return 0, fmt.Errorf("inspect free disk space: %w", err)
+	}
+	return uint64(stat.Bavail) * uint64(stat.Bsize), nil
+}
+
+func castOutputBytes(dir string) (uint64, error) {
+	entries, err := readCastDir(dir, castOutputEntryLimit)
+	if err != nil {
+		return 0, err
+	}
+	var total uint64
+	for _, entry := range entries {
+		info, err := entry.Info()
+		if err != nil {
+			return 0, fmt.Errorf("inspect cast output %q: %w", entry.Name(), err)
+		}
+		if !info.Mode().IsRegular() {
+			continue
+		}
+		size := uint64(info.Size())
+		if ^uint64(0)-total < size {
+			return 0, fmt.Errorf("cast output size overflow")
+		}
+		total += size
+	}
+	return total, nil
+}
+
+func outputBudget(dir string, limits castDiskLimits, free func(string) (uint64, error)) (uint64, error) {
+	if limits.maxOutputBytes == 0 || limits.minimumFreeBytes == 0 || limits.pollInterval <= 0 {
+		return 0, fmt.Errorf("invalid cast disk limits")
+	}
+	available, err := free(dir)
+	if err != nil {
+		return 0, err
+	}
+	if available <= limits.minimumFreeBytes {
+		return 0, fmt.Errorf("not enough free disk space to start AirPlay cast")
+	}
+	budget := available - limits.minimumFreeBytes
+	if budget > limits.maxOutputBytes {
+		budget = limits.maxOutputBytes
+	}
+	return budget, nil
+}
+
+type watchedOutputFile struct {
+	fd   int
+	info os.FileInfo
+}
+
+// castDirectoryWatcher uses kqueue vnode notifications for the HLS directory
+// and current regular files. It avoids repeatedly enumerating the directory
+// at a short fixed interval while still reconciling once per second for events
+// lost during a create/rename race.
+type castDirectoryWatcher struct {
+	kq    int
+	dirFD int
+	files map[string]watchedOutputFile
+}
+
+func newCastDirectoryWatcher(dir string) (*castDirectoryWatcher, error) {
+	kq, err := syscall.Kqueue()
+	if err != nil {
+		return nil, fmt.Errorf("create HLS disk watcher: %w", err)
+	}
+	syscall.CloseOnExec(kq)
+	dirFD, err := syscall.Open(dir, syscall.O_EVTONLY|syscall.O_CLOEXEC, 0)
+	if err != nil {
+		_ = syscall.Close(kq)
+		return nil, fmt.Errorf("open HLS output directory for disk watcher: %w", err)
+	}
+	w := &castDirectoryWatcher{kq: kq, dirFD: dirFD, files: make(map[string]watchedOutputFile)}
+	if err := w.addFD(dirFD); err != nil {
+		w.close()
+		return nil, fmt.Errorf("watch HLS output directory: %w", err)
+	}
+	if err := w.syncFiles(dir); err != nil {
+		w.close()
+		return nil, err
+	}
+	return w, nil
+}
+
+func (w *castDirectoryWatcher) addFD(fd int) error {
+	change := syscall.Kevent_t{
+		Ident:  uint64(fd),
+		Filter: syscall.EVFILT_VNODE,
+		Flags:  syscall.EV_ADD | syscall.EV_CLEAR,
+		Fflags: syscall.NOTE_WRITE | syscall.NOTE_DELETE | syscall.NOTE_RENAME,
+	}
+	_, err := syscall.Kevent(w.kq, []syscall.Kevent_t{change}, nil, nil)
+	return err
+}
+
+func (w *castDirectoryWatcher) syncFiles(dir string) error {
+	entries, err := readCastDir(dir, castOutputEntryLimit)
+	if err != nil {
+		return fmt.Errorf("reconcile HLS disk watcher: %w", err)
+	}
+	seen := make(map[string]os.FileInfo)
+	for _, entry := range entries {
+		info, err := entry.Info()
+		if err != nil {
+			return fmt.Errorf("inspect HLS watcher entry %q: %w", entry.Name(), err)
+		}
+		if !info.Mode().IsRegular() {
+			continue
+		}
+		path := filepath.Join(dir, entry.Name())
+		seen[path] = info
+		if current, ok := w.files[path]; ok && os.SameFile(current.info, info) {
+			continue
+		}
+		if current, ok := w.files[path]; ok {
+			_ = syscall.Close(current.fd)
+			delete(w.files, path)
+		}
+		fd, err := syscall.Open(path, syscall.O_EVTONLY|syscall.O_CLOEXEC, 0)
+		if err != nil {
+			if os.IsNotExist(err) {
+				continue // a completed HLS segment was concurrently pruned
+			}
+			return fmt.Errorf("open HLS output for disk watcher: %w", err)
+		}
+		if err := w.addFD(fd); err != nil {
+			_ = syscall.Close(fd)
+			return fmt.Errorf("watch HLS output file: %w", err)
+		}
+		w.files[path] = watchedOutputFile{fd: fd, info: info}
+	}
+	for path, file := range w.files {
+		if _, ok := seen[path]; !ok {
+			_ = syscall.Close(file.fd)
+			delete(w.files, path)
+		}
+	}
+	return nil
+}
+
+func (w *castDirectoryWatcher) wait(timeout time.Duration) (bool, bool, error) {
+	var events [64]syscall.Kevent_t
+	timespec := syscall.NsecToTimespec(int64(timeout))
+	n, err := syscall.Kevent(w.kq, nil, events[:], &timespec)
+	if err != nil {
+		if errors.Is(err, syscall.EINTR) {
+			return false, false, nil
+		}
+		return false, false, err
+	}
+	directoryChanged := false
+	for _, event := range events[:n] {
+		if event.Filter == syscall.EVFILT_VNODE && event.Ident == uint64(w.dirFD) {
+			directoryChanged = true
+		}
+	}
+	return n != 0, directoryChanged, nil
+}
+
+func (w *castDirectoryWatcher) close() {
+	for _, file := range w.files {
+		_ = syscall.Close(file.fd)
+	}
+	w.files = nil
+	if w.dirFD >= 0 {
+		_ = syscall.Close(w.dirFD)
+		w.dirFD = -1
+	}
+	if w.kq >= 0 {
+		_ = syscall.Close(w.kq)
+		w.kq = -1
+	}
+}
+
+// watchCastDiskUsage enforces the HLS high-water threshold and free-space
+// reserve. HLS itself retains only the live playlist window and two expired
+// segments. Disk notifications trigger checks at most once per poll interval;
+// a one-second reconciliation bounds missed vnode events. This remains a
+// fail-stop guard rather than a filesystem quota: media already written in
+// the current notification burst and scheduler delay can overshoot the
+// threshold before FFmpeg is stopped.
+func watchCastDiskUsage(dir string, budget, reserve uint64, poll time.Duration,
+	free func(string) (uint64, error)) (func(), <-chan error) {
+	stop := make(chan struct{})
+	var once sync.Once
+	result := make(chan error, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		watcher, err := newCastDirectoryWatcher(dir)
+		if err != nil {
+			result <- err
+			return
+		}
+		defer watcher.close()
+		check := func() error {
+			used, err := castOutputBytes(dir)
+			if err == nil && used > budget {
+				err = fmt.Errorf("HLS output exceeded the %d byte cast limit", budget)
+			}
+			if err == nil {
+				var available uint64
+				available, err = free(dir)
+				if err == nil && available < reserve {
+					err = fmt.Errorf("AirPlay cast stopped to preserve free disk space")
+				}
+			}
+			return err
+		}
+		if err := check(); err != nil {
+			result <- err
+			return
+		}
+		lastCheck := time.Now()
+		lastReconcile := lastCheck
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			timeout := 100 * time.Millisecond
+			changed, directoryChanged, err := watcher.wait(timeout)
+			if err != nil {
+				result <- fmt.Errorf("wait for HLS output changes: %w", err)
+				return
+			}
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			if directoryChanged && time.Since(lastReconcile) >= castDirectorySyncLimit {
+				if err := watcher.syncFiles(dir); err != nil {
+					result <- err
+					return
+				}
+				lastReconcile = time.Now()
+			}
+			if changed {
+				if time.Since(lastCheck) < poll {
+					remaining := poll - time.Since(lastCheck)
+					timer := time.NewTimer(remaining)
+					select {
+					case <-stop:
+						timer.Stop()
+						return
+					case <-timer.C:
+					}
+				}
+				if err := check(); err != nil {
+					result <- err
+					return
+				}
+				lastCheck = time.Now()
+				continue
+			}
+			if time.Since(lastReconcile) >= castDiskReconcileTime {
+				if err := watcher.syncFiles(dir); err != nil {
+					result <- err
+					return
+				}
+				if err := check(); err != nil {
+					result <- err
+					return
+				}
+				lastCheck = time.Now()
+				lastReconcile = lastCheck
+			}
+		}
+	}()
+	return func() {
+		once.Do(func() { close(stop) })
+		<-done // Kevent has a 100ms timeout, bounding the teardown join.
+	}, result
+}
