-		for _, m := range matches {
-			os.Remove(m)
+// fine. It uses one bounded enumeration instead of globbing once per pattern;
+// an unexpectedly large or unreadable directory is preserved and reported.
+func cleanOutDir(dir string) error {
+	entries, err := readCastDir(dir, castOutputEntryLimit)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("enumerate cast output for cleanup: %w", err)
+	}
+	for _, entry := range entries {
+		info, err := entry.Info()
+		if err != nil {
+			return fmt.Errorf("inspect cast cleanup entry %q: %w", entry.Name(), err)
+		}
+		if !info.Mode().IsRegular() {
+			continue
+		}
+		for _, pattern := range castArtifacts {
+			matched, err := filepath.Match(pattern, entry.Name())
+			if err != nil {
+				return fmt.Errorf("invalid cast cleanup pattern %q: %w", pattern, err)
+			}
+			if matched {
+				if err := os.Remove(filepath.Join(dir, entry.Name())); err != nil && !os.IsNotExist(err) {
+					return fmt.Errorf("remove cast artifact %q: %w", entry.Name(), err)
+				}
+				break
+			}
 		}
 	}
+	return nil
 }
+
+// readCastDir materializes at most limit+1 entries, returning an error before
+// callers mutate anything if a directory exceeds the expected bounded set.
+func readCastDir(dir string, limit int) ([]os.DirEntry, error) {
+	if limit <= 0 {
+		return nil, fmt.Errorf("invalid directory entry limit %d", limit)
+	}
+	if err := verifyNoSymlinkDirectoryPath(dir, false); err != nil {
+		return nil, err
+	}
+	file, err := os.Open(dir)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	entries, err := file.ReadDir(limit + 1)
+	if err != nil && !os.IsNotExist(err) && err != io.EOF {
+		return nil, err
+	}
+	if len(entries) > limit {
+		return nil, fmt.Errorf("directory %q exceeds %d entry limit", dir, limit)
+	}
+	return entries, nil
+}
