+func TestPruningRejectsUnsafeOrOversizedPIDFiles(t *testing.T) {
+	tests := []struct {
+		name    string
+		makePID func(t *testing.T, out string)
+	}{
+		{
+			name: "symlink",
+			makePID: func(t *testing.T, out string) {
+				target := filepath.Join(filepath.Dir(out), "pid-target")
+				if err := os.WriteFile(target, []byte(strconv.Itoa(os.Getpid())), 0o600); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink(target, filepath.Join(out, "helper.pid")); err != nil {
+					t.Fatal(err)
+				}
+			},
+		},
+		{
+			name: "oversized",
+			makePID: func(t *testing.T, out string) {
+				if err := os.WriteFile(filepath.Join(out, "helper.pid"), []byte(strings.Repeat("1", processFileMaxBytes+1)), 0o600); err != nil {
+					t.Fatal(err)
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			root := t.TempDir()
+			out := filepath.Join(root, "cast-stale")
+			if err := os.Mkdir(out, 0o700); err != nil {
+				t.Fatal(err)
+			}
+			now := time.Now()
+			if err := os.WriteFile(filepath.Join(out, instanceStopName), []byte(strconv.FormatInt(now.Add(-time.Hour).Unix(), 10)), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			keep := filepath.Join(out, "index.m3u8")
+			if err := os.WriteFile(keep, []byte("keep"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			tt.makePID(t, out)
+			if err := pruneExpiredCastDirs(root, "", now); err == nil {
+				t.Fatal("pruning accepted unsafe PID evidence")
+			}
+			if data, err := os.ReadFile(keep); err != nil || string(data) != "keep" {
+				t.Fatalf("unsafe PID evidence did not preserve cast output: data=%q err=%v", data, err)
+			}
+		})
+	}
+}
+
+func TestLifecycleLockWaitsForOwnerRelease(t *testing.T) {
+	out := t.TempDir()
+	first, err := lockInstance(out, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	started := time.Now()
+	secondResult := make(chan error, 1)
+	go func() {
+		second, err := lockInstance(out, time.Second)
+		if err == nil {
+			err = second.release()
+		}
+		secondResult <- err
+	}()
+	time.Sleep(50 * time.Millisecond)
+	select {
+	case err := <-secondResult:
+		t.Fatalf("second lifecycle lock acquired before release: %v", err)
+	default:
+	}
+	if err := first.release(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-secondResult:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("second lifecycle lock did not acquire after release")
+	}
+	if elapsed := time.Since(started); elapsed > time.Second {
+		t.Fatalf("lock wait exceeded bound: %s", elapsed)
+	}
+}
