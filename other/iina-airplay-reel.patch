+// A child can close the inherited output pipes and outlive ffmpeg itself.
+// stop() must signal the process group and wait until all descendants exit
+// before it authorizes cleanup.
+func TestRunJobStopPreservesOutputForUnownedDescendant(t *testing.T) {
+	c := baseCfg()
+	c.OutDir = t.TempDir()
+	childPIDPath := filepath.Join(c.OutDir, "child.pid")
+	stub := writeStubFFmpeg(t, `trap 'exit 0' TERM
+(trap '' TERM; exec sleep 30) >/dev/null 2>&1 &
+echo $! > "`+childPIDPath+`"
+wait`)
+	c.FFmpeg = stub
+	var buf bytes.Buffer
+	stop, done := RunJob(c, &buf)
+	groupData, err := os.ReadFile(filepath.Join(c.OutDir, ffmpegPIDName))
+	if err != nil {
+		t.Fatalf("read ffmpeg pidfile: %v", err)
+	}
+	pgid, err := strconv.Atoi(strings.TrimSpace(string(groupData)))
+	if err != nil {
+		t.Fatalf("parse ffmpeg process group: %v", err)
+	}
+	t.Cleanup(func() { _ = syscall.Kill(-pgid, syscall.SIGKILL) })
+	childDeadline := time.Now().Add(time.Second)
+	for {
+		if _, err := os.Stat(childPIDPath); err == nil {
+			break
+		}
+		if time.Now().After(childDeadline) {
+			t.Fatal("stub did not publish child pid")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	started := time.Now()
+	if err := stop(); err != nil {
