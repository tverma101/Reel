+// isVirtualNetworkInterface rejects software interfaces when walking for a
+// fallback address. The default-route address remains preferred (except for
+// a VPN tunnel, where the physical private LAN address is more likely to be
+// reachable by the receiver); v0.4's explicit address override handles
+// multi-NIC setups where that route is not the receiver-facing interface.
+func isVirtualNetworkInterface(name string) bool {
+	name = strings.ToLower(name)
+	for _, prefix := range []string{"utun", "ipsec", "ppp", "tun", "tap", "wg", "tailscale",
+		"bridge", "veth", "docker", "vmnet", "awdl", "llw", "gif", "stf"} {
+		if strings.HasPrefix(name, prefix) {
+			return true
+		}
+	}
+	return false
+}
