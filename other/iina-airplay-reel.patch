+func TestParentExitTeardownRetriesAfterFailure(t *testing.T) {
+	now := time.Unix(100, 0)
+	attempts, sleeps := 0, 0
+	err := retryBounded(250*time.Millisecond, processProbeInterval,
+		func() time.Time { return now },
+		func(d time.Duration) { sleeps++; now = now.Add(d) },
+		func() error {
+			attempts++
+			if attempts == 1 {
+				return errors.New("transient stop failure")
+			}
+			return nil
+		})
+	if err != nil || attempts != 2 || sleeps != 1 {
+		t.Fatalf("retry err=%v attempts=%d sleeps=%d; want success on the bounded second attempt", err, attempts, sleeps)
+	}
+}
