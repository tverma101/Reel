+func TestFailureMarkerRetryWaitsForRecordedProcessGroupsToExit(t *testing.T) {
+	out := t.TempDir()
+	mediaPath := filepath.Join(out, "index.m3u8")
+	if err := os.WriteFile(mediaPath, []byte("#EXTM3U\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	const helperPID, ffmpegPGID = 101, 202
+	failure := fmt.Sprintf("version=1\nhelper_pid=%d\nffmpeg_pgid=%d\nmessage=simulated teardown failure\n", helperPID, ffmpegPGID)
+	if err := os.WriteFile(filepath.Join(out, instanceFailureName), []byte(failure), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	helperAlive, ffmpegAlive := true, true
+	helperOps := processController{
+		alive: func(pid int) bool { return pid == helperPID && helperAlive },
+		now:   time.Now,
+		sleep: func(time.Duration) {},
+	}
+	groupOps := processController{
+		alive: func(pgid int) bool { return pgid == ffmpegPGID && ffmpegAlive },
+		now:   time.Now,
+		sleep: func(time.Duration) {},
+	}
+	deadline := time.Unix(1, 0)
+	if err := stopInstanceWithProcesses(out, deadline, helperOps, groupOps); err == nil || !strings.Contains(err.Error(), "helper 101") {
+		t.Fatalf("first stop error=%v, want live recorded helper to block cleanup", err)
+	}
+	if _, err := os.Stat(mediaPath); err != nil {
+		t.Fatalf("first failed stop removed output: %v", err)
+	}
+	helperAlive = false
+	if err := stopInstanceWithProcesses(out, deadline, helperOps, groupOps); err == nil || !strings.Contains(err.Error(), "FFmpeg process group 202") {
+		t.Fatalf("second stop error=%v, want live recorded FFmpeg group to block cleanup", err)
+	}
+	if _, err := os.Stat(mediaPath); err != nil {
+		t.Fatalf("second failed stop removed output: %v", err)
+	}
+	ffmpegAlive = false
+	if err := stopInstanceWithProcesses(out, deadline, helperOps, groupOps); err != nil {
+		t.Fatalf("retry after both recorded process groups exited: %v", err)
+	}
+	if _, err := os.Stat(out); !os.IsNotExist(err) {
+		t.Fatalf("verified stopped cast directory remains: %v", err)
+	}
+}
