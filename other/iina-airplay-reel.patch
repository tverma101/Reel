new file mode 100644
index 0000000..a6c4d56f21eb8e89f17e0c970fb82c7d8a581d17
--- /dev/null
+++ b/helper/token.go
@@ -0,0 +1,16 @@
+package main
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+)
+
+// NewCastToken returns a random 128-bit path capability. It is held only in
+// process memory and shared only with the selected AirPlay receiver URL.
+func NewCastToken() (string, error) {
+	var value [16]byte
+	if _, err := rand.Read(value[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(value[:]), nil
+}
