+// authorizedArtifact accepts only the random per-cast path and files the HLS
+// muxer is expected to create. No request can list the output directory or
+// read helper.pid, even after a client obtains the cast URL.
+func authorizedArtifact(requestPath, token string) (string, bool) {
+	parts := strings.SplitN(strings.TrimPrefix(requestPath, "/"), "/", 2)
+	if len(parts) != 2 || len(parts[0]) != len(token) ||
+		subtle.ConstantTimeCompare([]byte(parts[0]), []byte(token)) != 1 {
+		return "", false
+	}
+	name := parts[1]
+	if name == "" || path.Clean(name) != name || strings.ContainsAny(name, `/\\`) {
+		return "", false
+	}
+	if !allowedCastArtifact(name) {
+		return "", false
+	}
+	return name, true
+}
+
+func allowedCastArtifact(name string) bool {
+	switch name {
+	case "index.m3u8", "master.m3u8", "index_vtt.m3u8", "init.mp4":
+		return true
+	}
+	for _, suffix := range []string{".m4s", ".vtt"} {
+		prefix := "seg_"
+		if suffix == ".vtt" && strings.HasPrefix(name, "index") {
+			prefix = "index"
+		}
+		if !strings.HasPrefix(name, prefix) || !strings.HasSuffix(name, suffix) {
+			continue
+		}
+		sequence := strings.TrimSuffix(strings.TrimPrefix(name, prefix), suffix)
+		if sequence == "" {
+			return false
+		}
+		if _, err := strconv.ParseUint(sequence, 10, 64); err == nil {
+			return true
+		}
+	}
+	return false
+}
