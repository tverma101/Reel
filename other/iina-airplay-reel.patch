+		t.Fatal(err)
+	}
+	conn, err := net.Dial("tcp", fmt.Sprintf("127.0.0.1:%d", port))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if _, err := io.WriteString(conn, "GET /"+testCastToken+"/seg_0000.m4s HTTP/1.1\r\nHost: localhost\r\n\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	resp, err := http.ReadResponse(bufio.NewReader(conn), &http.Request{Method: http.MethodGet})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("media response status=%d", resp.StatusCode)
+	}
+	started := time.Now()
+	if err := shutdown(); err != nil {
+		t.Fatalf("bounded force-close shutdown returned error: %v", err)
+	}
+	if elapsed := time.Since(started); elapsed > time.Second {
+		t.Fatalf("stalled response delayed shutdown for %s", elapsed)
+	}
+	assertClosedByDeadline(t, conn, time.Second)
+}
+
+func testServerLimits(maxConnections int) serverLimits {
+	limits := productionServerLimits
+	limits.readHeaderTimeout = time.Second
+	limits.idleTimeout = time.Second
+	limits.maxConnections = maxConnections
+	limits.shutdownTimeout = time.Second
+	return limits
+}
+
+func mustGetKeepAlive(t *testing.T, addr string) net.Conn {
+	t.Helper()
+	conn, err := tryGetKeepAlive(addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return conn
+}
+
+func tryGetKeepAlive(addr string) (net.Conn, error) {
+	conn, err := net.Dial("tcp", addr)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := io.WriteString(conn, "GET /"+testCastToken+"/index.m3u8 HTTP/1.1\r\nHost: localhost\r\n\r\n"); err != nil {
+		conn.Close()
+		return nil, err
+	}
+	resp, err := http.ReadResponse(bufio.NewReader(conn), &http.Request{Method: http.MethodGet})
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	if _, err := io.Copy(io.Discard, resp.Body); err != nil {
+		resp.Body.Close()
+		conn.Close()
+		return nil, err
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusOK || resp.Close {
+		conn.Close()
+		return nil, fmt.Errorf("keep-alive request status=%d close=%v", resp.StatusCode, resp.Close)
+	}
+	return conn, nil
+}
+
+func assertClosedByDeadline(t *testing.T, conn net.Conn, wait time.Duration) {
+	t.Helper()
+	if err := conn.SetReadDeadline(time.Now().Add(wait)); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 256)
+	for {
+		_, err := conn.Read(buf)
+		if err == nil {
+			continue // a slow-header timeout may send a 400 before closing
+		}
+		if netErr, ok := err.(net.Error); ok && netErr.Timeout() {
+			t.Fatalf("connection remained open for %s: %v", wait, err)
+		}
+		return
+	}
+}
